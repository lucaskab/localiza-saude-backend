model healthcare_provider_faq {
  id                 String   @id @default(cuid())
  healthcareProviderId String   @map("healthcare_provider_id")
  healthcareProvider       user     @relation("ProviderFaqs", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  question           String
  answer             String
  position           Int      @default(0)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([healthcareProviderId])
  @@map("healthcare_provider_faqs")
}
