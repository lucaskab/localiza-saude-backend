model appointment {
  id                   String              @id @default(cuid())
  customerId        String?             @map("customer_id")
  customer              user?               @relation("CustomerAppointments", fields: [customerId], references: [id])
  patientProfileId     String?             @map("patient_profile_id")
  patientProfile       patient_profile?    @relation(fields: [patientProfileId], references: [id])
  healthcareProviderId   String              @map("healthcare_provider_id")
  healthcareProvider         user                @relation("ProviderAppointments", fields: [healthcareProviderId], references: [id])
  recurringSeriesId    String?             @map("recurring_series_id")
  recurringSeries      appointment_recurring_series? @relation(fields: [recurringSeriesId], references: [id], onDelete: SetNull)
  recurringRuleId      String?             @map("recurring_rule_id")
  recurringRule        appointment_recurring_series_rule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  recurringGeneratedAt DateTime?           @map("recurring_generated_at")
  scheduledAt          DateTime            @map("scheduled_at")
  status               AppointmentStatus   @default(SCHEDULED)
  serviceModality      String              @default("IN_PERSON") @map("service_modality")
  onlineMeetingUrl     String?             @map("online_meeting_url")
  onlineMeetingProvider String?            @map("online_meeting_provider")
  onlineMeetingExternalId String?          @map("online_meeting_external_id")
  onlineMeetingCreatedAt DateTime?         @map("online_meeting_created_at")
  totalDurationMinutes Int                 @map("total_duration_minutes")
  totalPriceCents      Int                 @map("total_price_cents")
  notes                String?
  cancellationReason   String?             @map("cancellation_reason")
  cancellationFeeCents Int?                @map("cancellation_fee_cents")
  cancellationPolicyAppliedAt DateTime?    @map("cancellation_policy_applied_at")
  cancelledAt          DateTime?           @map("cancelled_at")
  cancelledByUserId    String?             @map("cancelled_by_user_id")
  cancelledByUser      user?               @relation("AppointmentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  appointmentProcedures appointment_procedure[]
  relatedMessages       conversation_message[]
  notificationDeliveries notification_delivery[]
  rescheduleRequests    appointment_reschedule_request[]

  @@index([customerId])
  @@index([patientProfileId])
  @@index([healthcareProviderId])
  @@index([recurringSeriesId])
  @@index([recurringRuleId])
  @@index([cancelledByUserId])
  @@index([scheduledAt])
  @@map("appointments")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model appointment_reschedule_request {
  id                  String                             @id @default(cuid())
  appointmentId       String                             @map("appointment_id")
  appointment         appointment                        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  requestedByUserId   String                             @map("requested_by_user_id")
  requestedByUser     user                               @relation("UserAppointmentRescheduleRequests", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  proposedScheduledAt DateTime                           @map("proposed_scheduled_at")
  status              AppointmentRescheduleRequestStatus @default(PENDING)
  reason              String?
  respondedAt         DateTime?                          @map("responded_at")
  createdAt           DateTime                           @default(now()) @map("created_at")
  updatedAt           DateTime                           @updatedAt @map("updated_at")

  @@index([appointmentId])
  @@index([requestedByUserId])
  @@index([status])
  @@map("appointment_reschedule_requests")
}

enum AppointmentRescheduleRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model appointment_recurring_series {
  id                   String   @id @default(cuid())
  customerId           String?  @map("customer_id")
  customer             user?    @relation("CustomerRecurringAppointmentSeries", fields: [customerId], references: [id], onDelete: SetNull)
  patientProfileId     String?  @map("patient_profile_id")
  patientProfile       patient_profile? @relation(fields: [patientProfileId], references: [id], onDelete: SetNull)
  healthcareProviderId String   @map("healthcare_provider_id")
  healthcareProvider   user     @relation("ProviderRecurringAppointmentSeries", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  createdByUserId      String   @map("created_by_user_id")
  createdByUser        user     @relation("CreatedRecurringAppointmentSeries", fields: [createdByUserId], references: [id], onDelete: Cascade)
  serviceModality      String   @default("IN_PERSON") @map("service_modality")
  notes                String?
  startsOn             DateTime @map("starts_on")
  endsOn               DateTime? @map("ends_on")
  isIndefinite         Boolean  @default(false) @map("is_indefinite")
  isActive             Boolean  @default(true) @map("is_active")
  generatedUntil       DateTime? @map("generated_until")
  cancelledAt          DateTime? @map("cancelled_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  appointments appointment[]
  rules        appointment_recurring_series_rule[]
  procedures   appointment_recurring_series_procedure[]

  @@index([customerId, isActive])
  @@index([patientProfileId])
  @@index([healthcareProviderId, isActive])
  @@index([createdByUserId])
  @@map("appointment_recurring_series")
}

model appointment_recurring_series_rule {
  id         String   @id @default(cuid())
  seriesId    String   @map("series_id")
  series      appointment_recurring_series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      @map("day_of_week")
  startTime   String   @map("start_time")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  appointments appointment[]

  @@unique([seriesId, dayOfWeek, startTime])
  @@index([seriesId, dayOfWeek])
  @@map("appointment_recurring_series_rules")
}

model appointment_recurring_series_procedure {
  id         String   @id @default(cuid())
  seriesId    String   @map("series_id")
  series      appointment_recurring_series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  procedureId String   @map("procedure_id")
  procedure   procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([seriesId, procedureId])
  @@index([procedureId])
  @@map("appointment_recurring_series_procedures")
}

model appointment_waitlist_entry {
  id                   String                    @id @default(cuid())
  customerId           String                    @map("customer_id")
  customer             user                      @relation("CustomerAppointmentWaitlistEntries", fields: [customerId], references: [id], onDelete: Cascade)
  healthcareProviderId String                    @map("healthcare_provider_id")
  healthcareProvider   user                      @relation("ProviderAppointmentWaitlistEntries", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  desiredScheduledAt   DateTime                  @map("desired_scheduled_at")
  status               AppointmentWaitlistStatus @default(ACTIVE)
  lastNotifiedAt       DateTime?                 @map("last_notified_at")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  procedures           appointment_waitlist_entry_procedure[]

  @@unique([customerId, healthcareProviderId, desiredScheduledAt])
  @@index([customerId, status])
  @@index([healthcareProviderId, status, desiredScheduledAt])
  @@map("appointment_waitlist_entries")
}

enum AppointmentWaitlistStatus {
  ACTIVE
  CANCELLED
}

model appointment_waitlist_entry_procedure {
  id              String                     @id @default(cuid())
  waitlistEntryId String                     @map("waitlist_entry_id")
  waitlistEntry   appointment_waitlist_entry @relation(fields: [waitlistEntryId], references: [id], onDelete: Cascade)
  procedureId     String                     @map("procedure_id")
  procedure       procedure                  @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  createdAt       DateTime                   @default(now()) @map("created_at")

  @@unique([waitlistEntryId, procedureId])
  @@index([procedureId])
  @@map("appointment_waitlist_entry_procedures")
}
