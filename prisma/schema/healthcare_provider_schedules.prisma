model healthcare_provider_schedule {
  id                 String   @id @default(cuid())
  healthcareProviderId String   @map("healthcare_provider_id")
  healthcareProvider       user     @relation("ProviderSchedules", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  dayOfWeek          Int      @map("day_of_week")
  startTime          String   @map("start_time")
  endTime            String   @map("end_time")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([healthcareProviderId])
  @@map("healthcare_provider_schedules")
}

model healthcare_provider_schedule_exception {
  id                   String                @id @default(cuid())
  healthcareProviderId String                @map("healthcare_provider_id")
  healthcareProvider   user                  @relation("ProviderScheduleExceptions", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  date                 DateTime
  type                 ScheduleExceptionType
  startTime            String?               @map("start_time")
  endTime              String?               @map("end_time")
  reason               String?
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@index([healthcareProviderId, date])
  @@index([type])
  @@map("healthcare_provider_schedule_exceptions")
}

enum ScheduleExceptionType {
  DAY_OFF
  TIME_BLOCK
  SPECIAL_HOURS
  EXTRA_SLOT
}
