model account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String    @default(cuid())
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model appointment_procedure {
  id            String      @id @default(cuid())
  appointmentId String      @map("appointment_id")
  appointment   appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  procedureId   String      @map("procedure_id")
  procedure     procedure   @relation(fields: [procedureId], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([appointmentId])
  @@index([procedureId])
  @@map("appointment_procedures")
}

model appointment {
  id                          String                             @id @default(cuid())
  customerId                  String?                            @map("customer_id")
  customer                    user?                              @relation("CustomerAppointments", fields: [customerId], references: [id])
  patientProfileId            String?                            @map("patient_profile_id")
  patientProfile              patient_profile?                   @relation(fields: [patientProfileId], references: [id])
  healthcareProviderId        String                             @map("healthcare_provider_id")
  healthcareProvider          user                               @relation("ProviderAppointments", fields: [healthcareProviderId], references: [id])
  recurringSeriesId           String?                            @map("recurring_series_id")
  recurringSeries             appointment_recurring_series?      @relation(fields: [recurringSeriesId], references: [id], onDelete: SetNull)
  recurringRuleId             String?                            @map("recurring_rule_id")
  recurringRule               appointment_recurring_series_rule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  recurringGeneratedAt        DateTime?                          @map("recurring_generated_at")
  scheduledAt                 DateTime                           @map("scheduled_at")
  status                      AppointmentStatus                  @default(SCHEDULED)
  serviceModality             String                             @default("IN_PERSON") @map("service_modality")
  onlineMeetingUrl            String?                            @map("online_meeting_url")
  onlineMeetingProvider       String?                            @map("online_meeting_provider")
  onlineMeetingExternalId     String?                            @map("online_meeting_external_id")
  onlineMeetingCreatedAt      DateTime?                          @map("online_meeting_created_at")
  totalDurationMinutes        Int                                @map("total_duration_minutes")
  totalPriceCents             Int                                @map("total_price_cents")
  notes                       String?
  cancellationReason          String?                            @map("cancellation_reason")
  cancellationFeeCents        Int?                               @map("cancellation_fee_cents")
  cancellationPolicyAppliedAt DateTime?                          @map("cancellation_policy_applied_at")
  cancelledAt                 DateTime?                          @map("cancelled_at")
  cancelledByUserId           String?                            @map("cancelled_by_user_id")
  cancelledByUser             user?                              @relation("AppointmentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  createdAt                   DateTime                           @default(now()) @map("created_at")
  updatedAt                   DateTime                           @updatedAt @map("updated_at")

  appointmentProcedures  appointment_procedure[]
  relatedMessages        conversation_message[]
  notificationDeliveries notification_delivery[]
  rescheduleRequests     appointment_reschedule_request[]

  @@index([customerId])
  @@index([patientProfileId])
  @@index([healthcareProviderId])
  @@index([recurringSeriesId])
  @@index([recurringRuleId])
  @@index([cancelledByUserId])
  @@index([scheduledAt])
  @@map("appointments")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model appointment_reschedule_request {
  id                  String                             @id @default(cuid())
  appointmentId       String                             @map("appointment_id")
  appointment         appointment                        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  requestedByUserId   String                             @map("requested_by_user_id")
  requestedByUser     user                               @relation("UserAppointmentRescheduleRequests", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  proposedScheduledAt DateTime                           @map("proposed_scheduled_at")
  status              AppointmentRescheduleRequestStatus @default(PENDING)
  reason              String?
  respondedAt         DateTime?                          @map("responded_at")
  createdAt           DateTime                           @default(now()) @map("created_at")
  updatedAt           DateTime                           @updatedAt @map("updated_at")

  @@index([appointmentId])
  @@index([requestedByUserId])
  @@index([status])
  @@map("appointment_reschedule_requests")
}

enum AppointmentRescheduleRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model appointment_recurring_series {
  id                   String           @id @default(cuid())
  customerId           String?          @map("customer_id")
  customer             user?            @relation("CustomerRecurringAppointmentSeries", fields: [customerId], references: [id], onDelete: SetNull)
  patientProfileId     String?          @map("patient_profile_id")
  patientProfile       patient_profile? @relation(fields: [patientProfileId], references: [id], onDelete: SetNull)
  healthcareProviderId String           @map("healthcare_provider_id")
  healthcareProvider   user             @relation("ProviderRecurringAppointmentSeries", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  createdByUserId      String           @map("created_by_user_id")
  createdByUser        user             @relation("CreatedRecurringAppointmentSeries", fields: [createdByUserId], references: [id], onDelete: Cascade)
  serviceModality      String           @default("IN_PERSON") @map("service_modality")
  notes                String?
  startsOn             DateTime         @map("starts_on")
  endsOn               DateTime?        @map("ends_on")
  isIndefinite         Boolean          @default(false) @map("is_indefinite")
  isActive             Boolean          @default(true) @map("is_active")
  generatedUntil       DateTime?        @map("generated_until")
  cancelledAt          DateTime?        @map("cancelled_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  appointments appointment[]
  rules        appointment_recurring_series_rule[]
  procedures   appointment_recurring_series_procedure[]

  @@index([customerId, isActive])
  @@index([patientProfileId])
  @@index([healthcareProviderId, isActive])
  @@index([createdByUserId])
  @@map("appointment_recurring_series")
}

model appointment_recurring_series_rule {
  id        String                       @id @default(cuid())
  seriesId  String                       @map("series_id")
  series    appointment_recurring_series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  dayOfWeek Int                          @map("day_of_week")
  startTime String                       @map("start_time")
  createdAt DateTime                     @default(now()) @map("created_at")
  updatedAt DateTime                     @updatedAt @map("updated_at")

  appointments appointment[]

  @@unique([seriesId, dayOfWeek, startTime])
  @@index([seriesId, dayOfWeek])
  @@map("appointment_recurring_series_rules")
}

model appointment_recurring_series_procedure {
  id          String                       @id @default(cuid())
  seriesId    String                       @map("series_id")
  series      appointment_recurring_series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  procedureId String                       @map("procedure_id")
  procedure   procedure                    @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  createdAt   DateTime                     @default(now()) @map("created_at")

  @@unique([seriesId, procedureId])
  @@index([procedureId])
  @@map("appointment_recurring_series_procedures")
}

model appointment_waitlist_entry {
  id                   String                    @id @default(cuid())
  customerId           String                    @map("customer_id")
  customer             user                      @relation("CustomerAppointmentWaitlistEntries", fields: [customerId], references: [id], onDelete: Cascade)
  healthcareProviderId String                    @map("healthcare_provider_id")
  healthcareProvider   user                      @relation("ProviderAppointmentWaitlistEntries", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  desiredScheduledAt   DateTime                  @map("desired_scheduled_at")
  status               AppointmentWaitlistStatus @default(ACTIVE)
  lastNotifiedAt       DateTime?                 @map("last_notified_at")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  procedures appointment_waitlist_entry_procedure[]

  @@unique([customerId, healthcareProviderId, desiredScheduledAt])
  @@index([customerId, status])
  @@index([healthcareProviderId, status, desiredScheduledAt])
  @@map("appointment_waitlist_entries")
}

enum AppointmentWaitlistStatus {
  ACTIVE
  CANCELLED
}

model appointment_waitlist_entry_procedure {
  id              String                     @id @default(cuid())
  waitlistEntryId String                     @map("waitlist_entry_id")
  waitlistEntry   appointment_waitlist_entry @relation(fields: [waitlistEntryId], references: [id], onDelete: Cascade)
  procedureId     String                     @map("procedure_id")
  procedure       procedure                  @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  createdAt       DateTime                   @default(now()) @map("created_at")

  @@unique([waitlistEntryId, procedureId])
  @@index([procedureId])
  @@map("appointment_waitlist_entry_procedures")
}

model category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  healthcareProviderCategories healthcare_provider_category[]

  @@map("categories")
}

model healthcare_provider_category {
  id                   String   @id @default(cuid())
  healthcareProviderId String   @map("healthcare_provider_id")
  healthcareProvider   user     @relation("ProviderCategories", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  categoryId           String   @map("category_id")
  category             category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now()) @map("created_at")

  @@unique([healthcareProviderId, categoryId])
  @@index([healthcareProviderId])
  @@index([categoryId])
  @@map("healthcare_provider_categories")
}

model clinic {
  id          String            @id @default(cuid())
  name        String
  phone       String
  description String?
  email       String            @unique
  type        ClinicType        @default(MEDICAL)
  address     String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  ownerId     String            @map("owner_id")
  owner       user              @relation("ClinicOwner", fields: [ownerId], references: [id])
  employees   clinic_employee[] @relation("ClinicEmployees")

  @@index([ownerId])
  @@map("clinics")
}

enum ClinicType {
  MEDICAL
  HEALTH
  DENTAL
  EYE
  BEAUTY
  FREE
}

model clinic_employee {
  id          String             @id @default(cuid())
  clinicId    String             @map("clinic_id")
  clinic      clinic             @relation("ClinicEmployees", fields: [clinicId], references: [id], onDelete: Cascade)
  userId      String             @map("user_id")
  user        user               @relation("ClinicEmployeeUser", fields: [userId], references: [id], onDelete: Cascade)
  role        ClinicEmployeeRole
  permissions ClinicPermission[] @default([])
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@unique([clinicId, userId])
  @@index([clinicId])
  @@index([userId])
  @@index([role])
  @@map("clinic_employees")
}

enum ClinicEmployeeRole {
  OWNER
  PROVIDER
  STAFF
}

enum ClinicPermission {
  MANAGE_PROVIDER_PROFILE
  MANAGE_PROVIDER_SCHEDULE
  MANAGE_APPOINTMENTS
  MANAGE_PROCEDURES
  VIEW_PATIENTS
  MANAGE_CLINIC_INFO
  MANAGE_STAFF
}

model customer_favorite_provider {
  customerId           String   @map("customer_id")
  customer             user     @relation("CustomerFavoriteProviders", fields: [customerId], references: [id], onDelete: Cascade)
  healthcareProviderId String   @map("healthcare_provider_id")
  healthcareProvider   user     @relation("ProviderFavoritedByCustomers", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now()) @map("created_at")

  @@id([customerId, healthcareProviderId])
  @@index([customerId])
  @@index([healthcareProviderId])
  @@map("customer_favorite_providers")
}

model customer_medical_record {
  id                    String   @id @default(cuid())
  customerId            String   @unique @map("customer_id")
  customer              user     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bloodType             String?  @map("blood_type")
  medications           String?
  chronicPain           String?  @map("chronic_pain")
  preExistingConditions String?  @map("pre_existing_conditions")
  allergies             String?
  surgeries             String?
  familyHistory         String?  @map("family_history")
  lifestyleNotes        String?  @map("lifestyle_notes")
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("customer_medical_records")
}

model healthcare_provider_schedule {
  id                   String   @id @default(cuid())
  healthcareProviderId String   @map("healthcare_provider_id")
  healthcareProvider   user     @relation("ProviderSchedules", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  dayOfWeek            Int      @map("day_of_week")
  startTime            String   @map("start_time")
  endTime              String   @map("end_time")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([healthcareProviderId])
  @@map("healthcare_provider_schedules")
}

model healthcare_provider_schedule_exception {
  id                   String                @id @default(cuid())
  healthcareProviderId String                @map("healthcare_provider_id")
  healthcareProvider   user                  @relation("ProviderScheduleExceptions", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  date                 DateTime
  type                 ScheduleExceptionType
  startTime            String?               @map("start_time")
  endTime              String?               @map("end_time")
  reason               String?
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@index([healthcareProviderId, date])
  @@index([type])
  @@map("healthcare_provider_schedule_exceptions")
}

enum ScheduleExceptionType {
  DAY_OFF
  TIME_BLOCK
  SPECIAL_HOURS
  EXTRA_SLOT
}

model healthcare_provider_faq {
  id                   String   @id @default(cuid())
  healthcareProviderId String   @map("healthcare_provider_id")
  healthcareProvider   user     @relation("ProviderFaqs", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  question             String
  answer               String
  position             Int      @default(0)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([healthcareProviderId])
  @@map("healthcare_provider_faqs")
}

model conversation {
  id                   String    @id @default(cuid())
  customerId           String    @map("customer_id")
  customer             user      @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  healthcareProviderId String    @map("healthcare_provider_id")
  healthcareProvider   user      @relation("ProviderConversations", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  lastMessageAt        DateTime? @map("last_message_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  messages conversation_message[]

  @@unique([customerId, healthcareProviderId])
  @@index([customerId])
  @@index([healthcareProviderId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model conversation_message {
  id                   String            @id @default(cuid())
  conversationId       String            @map("conversation_id")
  conversation         conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId             String            @map("sender_id")
  sender               user              @relation(fields: [senderId], references: [id])
  senderType           MessageSenderType @map("sender_type")
  messageType          MessageType       @map("message_type")
  content              String?
  relatedAppointmentId String?           @map("related_appointment_id")
  relatedAppointment   appointment?      @relation(fields: [relatedAppointmentId], references: [id], onDelete: SetNull)
  fileKey              String?           @map("file_key")
  fileName             String?           @map("file_name")
  fileSize             Int?              @map("file_size")
  fileMimeType         String?           @map("file_mime_type")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@index([conversationId])
  @@index([senderId])
  @@index([relatedAppointmentId])
  @@index([createdAt])
  @@map("conversation_messages")
}

enum MessageSenderType {
  CUSTOMER
  HEALTHCARE_PROVIDER
}

enum MessageType {
  TEXT
  FILE
}

model push_token {
  id         String       @id @default(cuid())
  userId     String       @map("user_id")
  user       user         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String       @unique
  platform   PushPlatform @default(UNKNOWN)
  deviceId   String?      @map("device_id")
  isActive   Boolean      @default(true) @map("is_active")
  lastUsedAt DateTime     @default(now()) @map("last_used_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([userId, isActive])
  @@map("push_tokens")
}

model notification_preference {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  user         user             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  pushEnabled  Boolean          @default(true) @map("push_enabled")
  emailEnabled Boolean          @default(false) @map("email_enabled")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_preferences")
}

model notification_delivery {
  id            String                     @id @default(cuid())
  userId        String                     @map("user_id")
  user          user                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       NotificationChannel
  appointmentId String?                    @map("appointment_id")
  appointment   appointment?               @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          NotificationType
  dedupeKey     String?                    @map("dedupe_key")
  status        NotificationDeliveryStatus @default(PENDING)
  expoTicketId  String?                    @map("expo_ticket_id")
  errorMessage  String?                    @map("error_message")
  sentAt        DateTime?                  @map("sent_at")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  @@unique([userId, type, channel, dedupeKey])
  @@index([appointmentId])
  @@index([type, status, channel])
  @@map("notification_deliveries")
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
  UNKNOWN
}

enum NotificationType {
  APPOINTMENT_REMINDER
  APPOINTMENT_STATUS_UPDATE
  NEW_APPOINTMENT_REQUEST
  WAITLIST_SLOT_AVAILABLE
  CUSTOMER_BIRTHDAY_GREETING
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationChannel {
  PUSH
  EMAIL
}

model patient_profile {
  id                            String    @id @default(cuid())
  fullName                      String    @map("full_name")
  dateOfBirth                   DateTime? @map("date_of_birth")
  cpf                           String?
  phone                         String?
  email                         String?
  address                       String?
  gender                        String?
  relationshipToCustomer        String?   @map("relationship_to_customer")
  notes                         String?
  customerOwnerId               String?   @map("customer_owner_id")
  customerOwner                 user?     @relation("CustomerPatientProfiles", fields: [customerOwnerId], references: [id], onDelete: SetNull)
  createdByHealthcareProviderId String?   @map("created_by_healthcare_provider_id")
  createdByHealthcareProvider   user?     @relation("ProviderCreatedPatientProfiles", fields: [createdByHealthcareProviderId], references: [id], onDelete: SetNull)
  bloodType                     String?   @map("blood_type")
  medications                   String?
  chronicPain                   String?   @map("chronic_pain")
  preExistingConditions         String?   @map("pre_existing_conditions")
  allergies                     String?
  surgeries                     String?
  familyHistory                 String?   @map("family_history")
  lifestyleNotes                String?   @map("lifestyle_notes")
  emergencyContactName          String?   @map("emergency_contact_name")
  emergencyContactPhone         String?   @map("emergency_contact_phone")
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  appointments               appointment[]
  recurringAppointmentSeries appointment_recurring_series[]

  @@index([fullName])
  @@index([phone])
  @@index([cpf])
  @@index([customerOwnerId])
  @@index([createdByHealthcareProviderId])
  @@map("patient_profiles")
}

model procedure {
  id                   String   @id @default(cuid())
  name                 String
  description          String?
  priceInCents         Int      @map("price_in_cents")
  durationInMinutes    Int      @map("duration_in_minutes")
  healthcareProviderId String   @map("healthcare_provider_id")
  healthcareProvider   user     @relation("ProviderProcedures", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  appointmentProcedures     appointment_procedure[]
  waitlistEntryProcedures   appointment_waitlist_entry_procedure[]
  checklistItems            procedure_checklist_item[]
  recurringSeriesProcedures appointment_recurring_series_procedure[]

  @@index([healthcareProviderId])
  @@map("procedures")
}

model procedure_checklist_item {
  id          String    @id @default(cuid())
  procedureId String    @map("procedure_id")
  procedure   procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  text        String
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([procedureId])
  @@map("procedure_checklist_items")
}

model rating {
  id                   String   @id @default(cuid())
  customerId           String   @map("customer_id")
  customer             user     @relation("CustomerRatings", fields: [customerId], references: [id], onDelete: Cascade)
  healthcareProviderId String   @map("healthcare_provider_id")
  healthcareProvider   user     @relation("ProviderRatings", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  rating               Int
  comment              String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([customerId, healthcareProviderId])
  @@index([customerId])
  @@index([healthcareProviderId])
  @@map("ratings")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @default(cuid()) @map("user_id")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model support_request {
  id           String               @id @default(cuid())
  userId       String               @map("user_id")
  type         SupportRequestType
  subject      String?
  message      String
  contactEmail String?              @map("contact_email")
  appVersion   String?              @map("app_version")
  platform     String?
  environment  String?
  status       SupportRequestStatus @default(OPEN)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("support_requests")
}

enum SupportRequestType {
  ACCOUNT_DELETION
  DATA_DELETION
  PROBLEM_REPORT
  FEEDBACK
  SUPPORT_CONTACT
}

enum SupportRequestStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

model user {
  id                                      String                   @id @default(cuid())
  name                                    String
  firstName                               String?                  @map("first_name")
  lastName                                String?                  @map("last_name")
  phone                                   String?
  email                                   String                   @unique
  emailVerified                           Boolean                  @default(false) @map("email_verified")
  image                                   String?
  role                                    UserRole                 @default(CUSTOMER)
  onboardingCompleted                     Boolean                  @default(true) @map("onboarding_completed")
  cpf                                     String?
  dateOfBirth                             DateTime?                @map("date_of_birth")
  address                                 String?
  displayName                             String?                  @map("display_name")
  document                                String?
  birthDate                               DateTime?                @map("birth_date")
  gender                                  String?
  languages                               String[]                 @default([])
  specialty                               String?
  professionalCategory                    String?                  @map("healthcare_provider_category")
  professionalId                          String?                  @map("professional_id")
  professionalCouncilId                   String?                  @map("professional_council_id")
  professionalCouncil                     professional_council?    @relation(fields: [professionalCouncilId], references: [id], onDelete: SetNull)
  licenseState                            String?                  @map("license_state")
  licenseDocumentKey                      String?                  @map("license_document_key")
  licenseDocumentFileName                 String?                  @map("license_document_file_name")
  licenseDocumentMimeType                 String?                  @map("license_document_mime_type")
  licenseDocumentSize                     Int?                     @map("license_document_size")
  licenseDocumentSha256                   String?                  @map("license_document_sha256")
  licenseDocumentUploadedAt               DateTime?                @map("license_document_uploaded_at")
  verificationStatus                      String                   @default("PENDING") @map("verification_status")
  verificationRejectionReason             String?                  @map("verification_rejection_reason")
  verifiedAt                              DateTime?                @map("verified_at")
  verifiedByUserId                        String?                  @map("verified_by_user_id")
  verifiedByUser                          user?                    @relation("VerifiedProviders", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  bio                                     String?
  approach                                String?
  education                               String?
  certifications                          String?
  yearsOfExperience                       Int?                     @map("years_of_experience")
  targetAudiences                         String[]                 @default([]) @map("target_audiences")
  serviceModalities                       String[]                 @default([]) @map("service_modalities")
  clinicAddress                           String?                  @map("clinic_address")
  clinicLatitude                          Float?                   @map("clinic_latitude")
  clinicLongitude                         Float?                   @map("clinic_longitude")
  clinicNeighborhood                      String?                  @map("clinic_neighborhood")
  clinicCity                              String?                  @map("clinic_city")
  clinicState                             String?                  @map("clinic_state")
  homeCareRadiusKm                        Int?                     @map("home_care_radius_km")
  acceptedInsurance                       String[]                 @default([]) @map("accepted_insurance")
  paymentMethods                          String[]                 @default([]) @map("payment_methods")
  bookingAvailabilityDays                 Int                      @default(60) @map("booking_availability_days")
  birthdayGreetingEmailEnabled            Boolean                  @default(false) @map("birthday_greeting_email_enabled")
  cancellationPolicy                      String?                  @map("cancellation_policy")
  cancellationPolicyEnabled               Boolean                  @default(false) @map("cancellation_policy_enabled")
  cancellationPolicyHoursBefore           Int?                     @map("cancellation_policy_hours_before")
  cancellationPolicyPenaltyType           CancellationPenaltyType? @map("cancellation_policy_penalty_type")
  cancellationPolicyFixedFeeCents         Int?                     @map("cancellation_policy_fixed_fee_cents")
  cancellationPolicyPercentage            Int?                     @map("cancellation_policy_percentage")
  cancellationPolicyRequiresJustification Boolean                  @default(false) @map("cancellation_policy_requires_justification")
  clinicPhotos                            String[]                 @default([]) @map("clinic_photos")
  termsAcceptedAt                         DateTime?                @map("terms_accepted_at")
  lgpdConsentAt                           DateTime?                @map("lgpd_consent_at")
  professionalResponsibilityAcceptedAt    DateTime?                @map("professional_responsibility_accepted_at")
  createdAt                               DateTime                 @default(now()) @map("created_at")
  updatedAt                               DateTime                 @updatedAt @map("updated_at")

  sessions        session[]
  accounts        account[]
  ownedClinics    clinic[]          @relation("ClinicOwner")
  clinicEmployees clinic_employee[] @relation("ClinicEmployeeUser")

  customerAppointments                        appointment[]                               @relation("CustomerAppointments")
  healthcareProviderAppointments              appointment[]                               @relation("ProviderAppointments")
  cancelledAppointments                       appointment[]                               @relation("AppointmentCancelledBy")
  procedures                                  procedure[]                                 @relation("ProviderProcedures")
  schedules                                   healthcare_provider_schedule[]              @relation("ProviderSchedules")
  scheduleExceptions                          healthcare_provider_schedule_exception[]    @relation("ProviderScheduleExceptions")
  healthcareProviderCategories                healthcare_provider_category[]              @relation("ProviderCategories")
  favoriteProviders                           customer_favorite_provider[]                @relation("CustomerFavoriteProviders")
  favoritedBy                                 customer_favorite_provider[]                @relation("ProviderFavoritedByCustomers")
  medicalRecord                               customer_medical_record?
  ratings                                     rating[]                                    @relation("CustomerRatings")
  receivedRatings                             rating[]                                    @relation("ProviderRatings")
  customerConversations                       conversation[]                              @relation("CustomerConversations")
  providerConversations                       conversation[]                              @relation("ProviderConversations")
  patientProfiles                             patient_profile[]                           @relation("CustomerPatientProfiles")
  createdPatientProfiles                      patient_profile[]                           @relation("ProviderCreatedPatientProfiles")
  faqs                                        healthcare_provider_faq[]                   @relation("ProviderFaqs")
  conversationMessages                        conversation_message[]
  pushTokens                                  push_token[]
  notificationPreferences                     notification_preference[]
  notificationDeliveries                      notification_delivery[]
  supportRequests                             support_request[]
  appointmentRescheduleRequests               appointment_reschedule_request[]            @relation("UserAppointmentRescheduleRequests")
  customerAppointmentWaitlistEntries          appointment_waitlist_entry[]                @relation("CustomerAppointmentWaitlistEntries")
  providerAppointmentWaitlistEntries          appointment_waitlist_entry[]                @relation("ProviderAppointmentWaitlistEntries")
  customerRecurringAppointmentSeries          appointment_recurring_series[]              @relation("CustomerRecurringAppointmentSeries")
  providerRecurringAppointmentSeries          appointment_recurring_series[]              @relation("ProviderRecurringAppointmentSeries")
  createdRecurringAppointmentSeries           appointment_recurring_series[]              @relation("CreatedRecurringAppointmentSeries")
  verifiedProviders                           user[]                                      @relation("VerifiedProviders")
  providerVerificationReviews                 provider_verification_review[]              @relation("ProviderVerificationReviews")
  adminProviderVerificationReviews            provider_verification_review[]              @relation("AdminProviderVerificationReviews")
  providerVerificationDocumentAccessLogs      provider_verification_document_access_log[] @relation("ProviderVerificationDocumentAccessLogs")
  adminProviderVerificationDocumentAccessLogs provider_verification_document_access_log[] @relation("AdminProviderVerificationDocumentAccessLogs")

  @@index([verifiedByUserId])
  @@index([professionalCouncilId])
  @@index([clinicCity])
  @@index([clinicNeighborhood])
  @@index([clinicLatitude, clinicLongitude])
  @@map("users")
}

model professional_council {
  id                 String   @id @default(cuid())
  acronym            String   @unique
  name               String
  profession         String
  allowsPriceDisplay Boolean  @default(true) @map("allows_price_display")
  priceDisplayNote   String?  @map("price_display_note")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  healthcareProviders user[]

  @@index([active])
  @@map("professional_councils")
}

enum UserRole {
  HEALTHCARE_PROVIDER
  CUSTOMER
  ADMIN
  STAFF
}

enum CancellationPenaltyType {
  FIXED
  PERCENTAGE
}

enum ProviderVerificationReviewStatus {
  APPROVED
  REJECTED
}

model provider_verification_review {
  id                   String                           @id @default(cuid())
  healthcareProviderId String                           @map("healthcare_provider_id")
  healthcareProvider   user                             @relation("ProviderVerificationReviews", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  reviewerUserId       String                           @map("reviewer_user_id")
  reviewerUser         user                             @relation("AdminProviderVerificationReviews", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  status               ProviderVerificationReviewStatus
  reason               String?
  internalNotes        String?                          @map("internal_notes")
  documentKey          String?                          @map("document_key")
  documentSha256       String?                          @map("document_sha256")
  createdAt            DateTime                         @default(now()) @map("created_at")

  @@index([healthcareProviderId])
  @@index([reviewerUserId])
  @@index([status])
  @@map("provider_verification_reviews")
}

model provider_verification_document_access_log {
  id                   String   @id @default(cuid())
  healthcareProviderId String   @map("healthcare_provider_id")
  healthcareProvider   user     @relation("ProviderVerificationDocumentAccessLogs", fields: [healthcareProviderId], references: [id], onDelete: Cascade)
  adminUserId          String   @map("admin_user_id")
  adminUser            user     @relation("AdminProviderVerificationDocumentAccessLogs", fields: [adminUserId], references: [id], onDelete: Cascade)
  documentKey          String   @map("document_key")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([healthcareProviderId])
  @@index([adminUserId])
  @@map("provider_verification_document_access_logs")
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}
